[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = /Users/andrewherr/.config/git/allowed_signers
[commit]
	gpgsign = true
[user]
	name = Andrew Herr
	email = andrew.herr@testdouble.com
	signingkey = /Users/andrewherr/.ssh/git_signing_key.pub
[diff]
	algorithm = histogram
[column]
	ui = auto
[branch]
	sort = -committerdate
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	updateRefs = true
	autoStash = true
[merge]
	conflictstyle = zdiff3
[color]
	ui = true
# New client identity: create ~/.gitconfig.<client> with [user] email (and
# name/signingkey only if they differ from the defaults above), add an
# includeif block below for its gitdir, and add a line to
# ~/.config/git/allowed_signers for the new email using the same signing key
# so `git log --show-signature` verifies commits under that identity too.
[includeif "gitdir:/Users/andrewherr/src/focused/**/.git"]
	path = ~/.gitconfig.focused
[includeif "gitdir:/Users/andrewherr/src/thoughtbot/**/.git"]
	path = ~/.gitconfig.thoughtbot
[remote]
	pushDefault = origin
[include]
	path = ~/.gitconfig.local
