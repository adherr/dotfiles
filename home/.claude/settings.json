{
  "env": {
    "EDITOR": "emacsclient",
    "VISUAL": "emacsclient",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "_ZO_DOCTOR": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(pbcopy)",
      "Bash(npx *)",
      "Bash(diff:*)",
      "WebFetch(domain:developers.cloudflare.com)",
      "mcp__honeycomb__*"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/src",
      "~/Downloads",
      "~/Screenshots"
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "han@han": true,
    "han-communication@han": true,
    "han-core@han": true,
    "han-documentation@han": true,
    "han-research@han": true,
    "han-planning@han": true,
    "han-coding@han": true,
    "han-github@han": true,
    "han-reporting@han": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "testdouble-skills-internal": {
      "source": {
        "source": "github",
        "repo": "testdouble/skills-internal"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "han": {
      "source": {
        "source": "github",
        "repo": "testdouble/han"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*.honeycomb.io"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowMachLookup": [
        "com.apple.pasteboard.1"
      ]
    },
    "enableWeakerNestedSandbox": true,
    "excludedCommands": [
      "git commit *",
      "git push *",
      "gh *"
    ]
  },
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "editorMode": "normal",
  "keybindingFlavor": "readline",
  "autoCompactEnabled": false
}
