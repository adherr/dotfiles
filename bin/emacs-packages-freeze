#!/usr/bin/env bash
set -euo pipefail

if ! emacsclient --eval '(+ 1 1)' >/dev/null 2>&1; then
  echo "No Emacs daemon reachable. Start Emacs first, then re-run." >&2
  exit 1
fi

emacsclient --eval '(straight-freeze-versions)'

echo
echo "Lockfile written to ~/.config/emacs/straight/versions/default.el"
echo "Commit it in the emacs submodule via magit."
