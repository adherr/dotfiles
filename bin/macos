#!/usr/bin/env bash
set -euo pipefail

# Runs every macOS-only setup script for this machine's role in one shot. Each
# step is also runnable on its own via its own `mise run` task.
bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
role="$("$bin/role")"

ssh_keys=0
printers=""
for arg in "$@"; do
  case "$arg" in
    --with-ssh-keys) ssh_keys=1 ;;
    --with-printers) printers="--with-printers" ;;
  esac
done

"$bin/macos-defaults"
"$bin/ghostty-terminfo-install"
"$bin/plexmono-install"

if [ "$role" = full ]; then
  "$bin/tableplus-defaults"
  # shellcheck disable=SC2086
  "$bin/cups-defaults" $printers
fi

# generates new credentials, so opt-in only
if [ "$ssh_keys" = 1 ]; then
  "$bin/ssh-keys-new-machine"
fi
