#!/usr/bin/env bash
set -euo pipefail

# Choosy resaves its prefs atomically (write-temp, rename over original), so
# symlinking behaviours.plist into place would get silently replaced by a
# plain file the next time a rule is edited. Keep a plain one-way backup
# instead and re-run this script after changing rules in Choosy's UI.

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src="$HOME/Library/Application Support/Choosy/behaviours.plist"

cp "$src" "$repo/macos/choosy-behaviours.plist"
echo "Backed up Choosy rules to macos/choosy-behaviours.plist"
