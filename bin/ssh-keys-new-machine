#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: ssh-keys-new-machine [--backend op|local] [--email EMAIL] [LABEL]" >&2
  exit 2
}

backend=""
email=""
label=""
while [ $# -gt 0 ]; do
  case "$1" in
    --backend) backend="${2:-}"; shift 2 ;;
    --email) email="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) label="$1"; shift ;;
  esac
done
label="${label:-$(scutil --get ComputerName 2>/dev/null || hostname -s)}"

if [ -z "$backend" ]; then
  if command -v op >/dev/null 2>&1 && op whoami >/dev/null 2>&1; then
    backend=op
  else
    backend=local
  fi
fi
[ "$backend" = op ] || [ "$backend" = local ] || usage

if [ -z "$email" ]; then
  read -rp "Commit email for this machine: " email
fi
[ -n "$email" ] || usage

gh auth status -h github.com >/dev/null 2>&1 || { echo "gh isn't logged in; run 'gh auth login' first." >&2; exit 1; }

mkdir -p ~/.ssh ~/.config/git
chmod 700 ~/.ssh
signing_key=~/.ssh/git_signing_key
auth_key=~/.ssh/id_ed25519

if [ "$backend" = op ]; then
  if ! op whoami >/dev/null 2>&1; then
    echo "1Password CLI isn't signed in." >&2
    echo "Enable Settings > Developer > 'Integrate with 1Password CLI' in the 1Password app, then re-run this task." >&2
    exit 1
  fi

  op_key() {
    local title="SSH Key - $label ($1)"
    if op item get "$title" >/dev/null 2>&1; then
      echo "==> Reusing existing 1Password item '$title'" >&2
    else
      echo "==> Generating '$title' in 1Password" >&2
      op item create --category="SSH Key" --title="$title" --ssh-generate-key=ed25519 >/dev/null
    fi
    op item get "$title" --fields label="public key" --reveal
  }
  auth_pub="$(op_key auth)"
  signing_pub="$(op_key signing)"

  printf '%s\n' "$signing_pub" > "$signing_key.pub"
  chmod 600 "$signing_key.pub"
else
  askpass="$(mktemp)"
  trap 'rm -f "$askpass"' EXIT
  printf '#!/bin/sh\nprintf %%s "$KEY_PASSPHRASE"\n' > "$askpass"
  chmod 700 "$askpass"

  generate() {
    local file="$1" comment="$2" pass
    if [ -e "$file" ]; then
      echo "==> Reusing existing $file"
      return
    fi
    pass="$(openssl rand -base64 24)"
    ssh-keygen -q -t ed25519 -N "$pass" -C "$comment" -f "$file"
    KEY_PASSPHRASE="$pass" SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force \
      ssh-add --apple-use-keychain "$file" 2>/dev/null
    PASSPHRASES+=("$comment: $pass")
  }

  PASSPHRASES=()
  echo "==> Generating passphrase-protected SSH keys for '$label'"
  generate "$auth_key" "$label (auth)"
  generate "$signing_key" "$label (signing)"

  auth_pub="$(cat "$auth_key.pub")"
  signing_pub="$(cat "$signing_key.pub")"

  if [ "${#PASSPHRASES[@]}" -gt 0 ]; then
    echo
    echo "Save these passphrases in LastPass now (the macOS keychain holds the only other copy):"
    printf '  %s\n' "${PASSPHRASES[@]}"
    echo
  fi

  if [ ! -e ~/.ssh/config ]; then
    cat > ~/.ssh/config <<EOF
Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile $auth_key
EOF
    chmod 600 ~/.ssh/config
  fi
fi

echo "==> Registering keys with GitHub"
gh auth refresh -h github.com -s admin:public_key,admin:ssh_signing_key

register_key() {
  local pub="$1" type="$2" endpoint="$3" kind="$4" keyfile
  # compare type + base64 body; GitHub drops the trailing comment
  if gh api "$endpoint" --paginate --jq '.[].key' | grep -qxF "$(printf '%s' "$pub" | awk '{print $1" "$2}')"; then
    echo "$type key already registered with GitHub; skipping"
    return
  fi
  keyfile="$(mktemp)"
  printf '%s\n' "$pub" > "$keyfile"
  gh ssh-key add "$keyfile" --type "$type" --title "$label ($kind)"
  rm -f "$keyfile"
}
register_key "$auth_pub" authentication user/keys auth
register_key "$signing_pub" signing user/ssh_signing_keys signing

allowed_signers=~/.config/git/allowed_signers
[ -L "$allowed_signers" ] && rm -f "$allowed_signers"
signer_line="$(printf '%s namespaces="git" %s' "$email" "$signing_pub")"
grep -qxF "$signer_line" "$allowed_signers" 2>/dev/null || printf '%s\n' "$signer_line" >> "$allowed_signers"

if [ -e ~/.gitconfig.local ]; then
  echo "~/.gitconfig.local already exists; not overwriting. It needs user.email = $email"
else
  {
    printf '[user]\n\temail = %s\n' "$email"
    if [ "$backend" = op ]; then
      printf '[gpg "ssh"]\n\tprogram = /Applications/1Password.app/Contents/MacOS/op-ssh-sign\n'
    fi
  } > ~/.gitconfig.local
fi

echo
echo "Done ($backend backend)."
if [ "$backend" = local ]; then
  echo "Add to your shell startup so keys reload after a reboot: ssh-add --apple-load-keychain -q"
fi
