#!/usr/bin/env bash
set -euo pipefail

# Enables the CUPS web admin interface at http://localhost:631
cupsctl WebInterface=yes

echo "CUPS web admin interface enabled: http://localhost:631"

# home-LAN printers; meaningless (and noisy to endpoint agents) elsewhere
if [ "${1:-}" != "--with-printers" ]; then
  echo "Skipping network printers (pass --with-printers to add them)"
  exit 0
fi

# Network printers, added by device URI. These are old enough (HP LaserJet
# 4250, etc.) that driverless IPP Everywhere isn't reliable — trout's IPP
# service (port 631) rejects every IPP version outright — so each is set up
# with a CUPS "Generic" driver instead.
declare -A printers=(
  [trout]="socket://192.168.1.5:9100"
  [rainbow_trout]="socket://192.168.1.99:9100"
)

# trout uses PCL rather than PostScript: printing PDFs from Firefox to the
# PostScript driver reliably hit "limitcheck / offending command image" —
# the 4250's PS interpreter running out of memory rasterizing images. PCL
# rasterizes on the Mac side via CUPS instead of on the printer, avoiding it.
declare -A drivers=(
  [trout]="drv:///sample.drv/generpcl.ppd"
  [rainbow_trout]="drv:///sample.drv/generic.ppd"
)

# rainbow_trout hit "ioerror / offending command image" mid-image: raw binary
# image bytes read as PS channel control chars. TBCP escapes them, but the
# generic PPD doesn't advertise it, so CUPS rejects protocol=TBCP without a patch.
declare -A protocols=(
  [rainbow_trout]="TBCP"
)

for name in "${!printers[@]}"; do
  uri="${printers[$name]}"
  driver="${drivers[$name]}"
  lpadmin -p "$name" -E -v "$uri" -m "$driver" -D "$name"
  if [ -n "${protocols[$name]:-}" ]; then
    ppd="$(mktemp)"
    { cat "/etc/cups/ppd/$name.ppd"; echo "*Protocols: ${protocols[$name]}"; } > "$ppd"
    lpadmin -p "$name" -P "$ppd"
    rm "$ppd"
    # separate call: -o is validated against the PPD in effect before -P applies
    lpadmin -p "$name" -o "protocol=${protocols[$name]}"
  fi
  # lpadmin -E enables the printer but doesn't clear a "rejecting jobs" state
  cupsaccept "$name"
  echo "Printer added: $name ($uri)"
done
