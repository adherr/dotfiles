# start with nothing
/*
sockets

# allowlist only. Top level directories are unignored in sections with their contents
!/dotfiles
!/.gitignore
!/.gitconfig*
!/Brewfile

!/.zshrc
!/.zshenv

# I want the docker config for reference, although it might screw me up when I forget it
!/.docker
/.docker/*
!/.docker/config.json


!/.config
/.config/*
!/.config/emacs
/.config/iterm2/*
!/.config/iterm2/com.googlecode.iterm2.plist
!/.config/iterm2/iterm2_shell_integration.zsh
!/.config/starship.toml


!/.claude
/.claude/*
!/.claude/settings.json
!/.claude/CLAUDE.md
!/.claude/keybindings.json


!/Library
/Library/*
!/Library/Application Support
/Library/Application Support/*
!/Library/Application Support/Cursor
/Library/Application Support/Cursor/*
!/Library/Application Support/Cursor/User
/Library/Application Support/Cursor/User/*
!/Library/Application Support/Cursor/User/settings.json
!/Library/Application Support/Cursor/User/keybindings.json
