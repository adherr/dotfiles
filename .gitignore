# start with nothing
/*
sockets

# allowlist only. Top level directories are unignored in sections with their contents
!/dotfiles
!/.gitignore
!/.gitconfig*
!/Brewfile

!/.zshrc

# I want the docker config for reference, although it might screw me up when I forget it
!/.docker
/.docker/*
!/.docker/config.json


!/.config
/.config/*
!/.config/emacs
!/.config/iterm2
!/.config/starship.toml


!/.claude
/.claude/*
!/.claude/settings.json
!/.claude/CLAUDE.md
!/.claude/keybindings.json
